import { SlashCommandBuilder, MessageFlags } from 'discord.js';
import { successEmbed } from '../../utils/embeds.js';
import { InteractionHelper } from '../../utils/interactionHelper.js';

export default {
    data: new SlashCommandBuilder()
        .setName('gmm')
        .setDescription('GMM commands')
        .addSubcommand(subcommand =>
            subcommand
                .setName('countdown')
                .setDescription('Show the countdown until 20 June 2027 at 00:00 CEST')
        ),

    async execute(interaction) {
        await InteractionHelper.safeExecute(
            interaction,
            async () => {
                const now = new Date();

                // 20 June 2027, 00:00 CEST (UTC+2)
                const target = new Date('2027-06-19T22:00:00.000Z');

                const difference = target.getTime() - now.getTime();

                if (difference <= 0) {
                    const embed = successEmbed(
                        '🎉 GMM Countdown',
                        '**20 juni 2027 om 00:00 CEST is bereikt!** 🎉'
                    );

                    await InteractionHelper.safeEditReply(interaction, {
                        embeds: [embed]
                    });

                    return;
                }

                const totalSeconds = Math.floor(difference / 1000);

                const days = Math.floor(totalSeconds / 86400);
                const hours = Math.floor((totalSeconds % 86400) / 3600);
                const minutes = Math.floor((totalSeconds % 3600) / 60);
                const seconds = totalSeconds % 60;

                // Unix timestamp voor Discord's dynamische countdown
                const unixTimestamp = Math.floor(target.getTime() / 1000);

                const embed = successEmbed(
                    '🎪 GMM Countdown',
                    `# ⏳ Nog te gaan\n\n` +
                    `**${days} dagen**\n` +
                    `**${hours} uur**\n` +
                    `**${minutes} minuten**\n` +
                    `**${seconds} seconden**\n\n` +
                    `📅 **20 juni 2027**\n` +
                    `🕛 **00:00 CEST**\n\n` +
                    `🗓️ <t:${unixTimestamp}:F>\n` +
                    `⏱️ <t:${unixTimestamp}:R>`
                );

                await InteractionHelper.safeEditReply(interaction, {
                    embeds: [embed]
                });
            },
            'Failed to generate the GMM countdown. Please try again.',
            {
                autoDefer: true,
                deferOptions: { flags: MessageFlags.Ephemeral }
            }
        );
    },
};
