import os
import discord
from discord import app_commands
from discord.ext import commands
from dotenv import load_dotenv

# Laad de token uit het .env bestand
load_dotenv()
TOKEN = os.getenv('DISCORD_TOKEN')

class MyBot(commands.Bot):
    def __init__(self):
        # We hebben de standaard intents nodig
        intents = discord.Intents.default()
        super().__init__(command_prefix="!", intents=intents)

    async def setup_hook(self):
        # Dit zorgt ervoor dat de slash commands worden gesynchroniseerd met Discord
        await self.tree.sync()

bot = MyBot()

@bot.event
async def on_ready():
    print(f'{bot.user.name} is online en de Slash Commands zijn gesynchroniseerd!')

# Het /gmm countdown commando
@bot.tree.command(name="gmm", description="Toon de uitgebreide countdown naar 17 juni 2027")
async def gmm_countdown(interaction: discord.Interaction, sub_command: str = "countdown"):
    # Als de gebruiker handmatig iets anders typt dan countdown, vangen we dat netjes op
    if sub_command != "countdown":
        await interaction.response.send_message("Bedoelde je misschien `/gmm countdown`?", ephemeral=True)
        return

    # UNIX-timestamp voor 17 juni 2027 (00:00:00 UTC)
    # Discord vertaalt dit automatisch naar de lokale tijdzone van de gebruiker!
    target_timestamp = 1813190400

    # We maken gebruik van Discord's speciale tijdnotaties:
    # :R = Relatieve tijd (bijv. "in 1 jaar")
    # :F = Volledige datum en tijd (bijv. "donderdag 17 juni 2027 02:00")
    embed = discord.Embed(
        title="🎸 Graspop Metal Meeting 2027 Countdown!",
        color=discord.Color.dark_red(),
        description="De teller loopt! Ben jij er al klaar voor?"
    )
    
    embed.add_field(
        name="⏳ Tijd Resterend", 
        value=f"**<t:{target_timestamp}:R>**", 
        inline=False
    )
    embed.add_field(
        name="📅 Doeldatum", 
        value=f"<t:{target_timestamp}:F>", 
        inline=False
    )
    embed.set_footer(text="De live timer past zich automatisch aan jouw tijdzone aan!")

    # Stuur het uitgebreide overzicht in de chat
    await interaction.response.send_message(embed=embed)

bot.run(TOKEN)
